# When empty, the frontend uses relative URLs (same-origin via API gateway).
# Set this only for local development when frontend runs on a separate port.
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Vite dev-server proxy target. Only used by `vite dev` / `vite preview`;
# ignored by production builds (vite build). Leave commented to default to
# http://localhost:8080. Override per-developer in .env.local (gitignored).
# API_PROXY_TARGET=http://localhost:8080
